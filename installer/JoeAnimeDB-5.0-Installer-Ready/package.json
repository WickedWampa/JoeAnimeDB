{
  "name": "joeanime-db-4",
  "version": "5.0.0",
  "private": true,
  "description": "JoeAnimeDB desktop anime library powered by JoeAI",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "web": "vite",
    "desktop": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win nsis portable",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.11.1",
    "concurrently": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.joeanimedb.app",
    "productName": "JoeAnimeDB",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JoeAnimeDB-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JoeAnimeDB",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "JoeAnimeDB-${version}-${arch}.${ext}"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
