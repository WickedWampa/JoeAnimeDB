{
  "name": "joeanime-db-4",
  "version": "5.0.0-beta.13",
  "private": true,
  "description": "JoeAnimeDB desktop anime library powered by JoeAI",
  "author": "WickedWampa",
  "homepage": "https://wickedwampa.itch.io/joeanime-db",
  "desktopName": "JoeAnimeDB.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/startDesktopDev.cjs",
    "dev:inner": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "web": "vite",
    "desktop": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win nsis",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:portable": "npm run build && electron-builder --win portable",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "release:linux": "npm run build && electron-builder --linux AppImage --x64 --publish always",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk": "npm run android:debug",
    "test:reliability": "node scripts/testJoeAIRouting.mjs && node scripts/testNewUserReliability.mjs",
    "test:release": "npm run test:reliability && node scripts/testReleaseGate.mjs",
    "test:release:live": "npm run test:reliability && node scripts/testReleaseGate.mjs --live"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.11.1",
    "concurrently": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.joeanimedb.app",
    "productName": "JoeAnimeDB",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/generateGenomeCardForTitle.cjs",
      "scripts/generateMissingGenomesForList.cjs",
      "scripts/rebuildGenomeRegistry.cjs",
      "installer/joeanime.ico",
      "installer/joeanime.png",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WickedWampa",
        "repo": "JoeAnimeDB",
        "releaseType": "prerelease"
      }
    ],
    "win": {
      "icon": "installer/joeanime.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JoeAnimeDB-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "installer/joeanime.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Offline-first anime tracking and personalized recommendations",
      "description": "JoeAnimeDB learns from your library, ratings and rewatches to build Anime DNA and explainable recommendations.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "JoeAnimeDB-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "license": "installer/LICENSE.txt",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JoeAnimeDB",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
